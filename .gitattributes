# Normalize all text files to LF in the repository.
# Editors on Windows can still display CRLF locally if configured to do so,
# but the stored version is always LF — consistent across Windows and macOS.
* text=auto eol=lf

# Binaries — never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.icns binary
*.gif  binary
*.webp binary
*.mp4  binary
*.mov  binary
*.exe  binary
*.dll  binary
*.msi  binary
